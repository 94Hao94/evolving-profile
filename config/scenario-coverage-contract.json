{
  "schema": "segment_coverage.v1",
  "navigation_schema": "scenario-segmented-navigation.v1",
  "default_review_protocol": "segment_coverage.v1",
  "review_protocols": {
    "segment_coverage.v1": {"navigation_schema":"scenario-segmented-navigation.v1","exhaustive":true},
    "hierarchical_review.v1": {
      "navigation_schema":"scenario-hierarchical-navigation.v1","exhaustive":false,
      "defaults":{"partition_input_tokens":12000},
      "raw_source_window_bytes":2000,
      "output_recovery":{"max_depth":3,"min_child_bytes":128,"max_additional_windows":16},
      "statuses":["source_pending","local_candidate","intent_gap","relation_pending","capacity_paused","budget_paused","scope_reviewed","stale","unavailable"],
      "stages":["extract","leaf","merge","readback"],
      "authorities":["user_requirement","user_claim","assistant_suggestion","assistant_report","external_evidence"],
      "obligation_terminal_states":["supported","refuted","not_applicable"],
      "judgment_schema":"attribution-scope-outcome.v1",
      "attribution_states":["sufficient","defective","needs_context"],
      "scope_states":["resolved","unresolved","needs_context"],
      "context_recovery":{"max_rounds":2,"max_units":3,"max_page_chars":512},
      "host_plane_wire":{"schema":"source-selection.v3","required_source_roles":["user","assistant"],"residual_kinds":["non_substantive","unclassified"],
        "roles":{"user":{"plane":"atoms","default_authority":"user_requirement","kind_authority":{"claim":"user_claim"},"kinds":["request","constraint","correction","question","confirmation","claim","non_substantive","unclassified"]},
          "assistant":{"plane":"assistant_claims","default_authority":"assistant_report","kind_authority":{"suggestion":"assistant_suggestion"},"kinds":["request","constraint","correction","question","confirmation","claim","report","suggestion","non_substantive","unclassified"]}}},
      "selection_wire":{"schema":"source-selection.v2","identity_version":"source_semantics.v2","new_obligation_prefix":"new:",
        "alias_prefixes":{"span":"s","atom":"i","residual":"z","assistant_claim":"a","prior_state":"i","obligation":"o","source_page":"p","context_page":"c"},
        "relation_kinds":["same_object","responds_to","corrects","supersedes","contradicts"],
        "relation_to_record_kind":{"same_object":"identity","responds_to":"response_relation","corrects":"correction","supersedes":"correction","contradicts":"contradiction"},
        "record_obligation_kinds":["identity","reference","chronology","condition","correction","response_relation","contradiction"]},
      "extraction_repair":{"max_requests":1,"max_feedback_items":32,
        "mapping_errors":["selection_schema_invalid","selection_card_invalid","selection_fields_invalid","selection_mixed_roles","assistant_character_gap","proposal_shape","proposal_fields","atom_source_missing","atom_quote_invalid","atom_quote_ambiguous_or_absent","atom_source_selector_invalid","atom_authority_or_role","atom_source_order","atom_semantics_missing","atom_condition_invalid","atom_scope_invalid","residual_reason_invalid","duplicate_atom","intent_character_gap","malformed_proposal"]}
    }
  },
  "source_selection_version": "visible-user-native-final.v2",
  "minimum_limits": {"partition_input_tokens":4},
  "mode": "source_shadow",
  "modes": ["source_shadow", "assisted", "enforced"],
  "editable_limits": ["input_bytes", "output_bytes", "wall_seconds", "line_bytes", "partition_input_tokens", "context_tokens"],
  "statuses": ["source_missing", "source_preparing", "partial", "local_reviewed", "global_pending", "conflicted", "budget_paused", "accepted", "stale", "unavailable", "invalid"],
  "defaults": {
    "input_bytes": 33554432,
    "output_bytes": 67108864,
    "wall_seconds": 5,
    "line_bytes": 8388608,
    "spool_source_bytes": 1073741824,
    "spool_total_bytes": 2147483648,
    "active_decoders": 1,
    "partition_input_tokens": 6000,
    "partition_output_tokens": 2000,
    "context_tokens": 512,
    "model_requests": 0,
    "model_tokens": 0,
    "pilot_requests": 2,
    "pilot_tokens": 16000,
    "parent_max_attempts": 3
  }
}
