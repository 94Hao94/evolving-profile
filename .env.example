# Copy to .env locally; never commit the real file.
EP_BANK_ID=personal-memory
EVOLVING_PROFILE_API_LLM_PROVIDER=openai
EVOLVING_PROFILE_API_LLM_MODEL=
EVOLVING_PROFILE_API_LLM_API_KEY=
EVOLVING_PROFILE_API_LLM_BASE_URL=
# Existing PostgreSQL/pgvector URL; or explicit pg0 after embedded-db install.
EVOLVING_PROFILE_API_DATABASE_URL=
# Separate embedding service; a chat subscription may not offer embeddings.
EVOLVING_PROFILE_API_EMBEDDINGS_PROVIDER=openai
EVOLVING_PROFILE_API_EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small
EVOLVING_PROFILE_API_EMBEDDINGS_OPENAI_API_KEY=
EVOLVING_PROFILE_API_EMBEDDINGS_OPENAI_BASE_URL=
# Rank fusion does not download a learned local reranker.
EVOLVING_PROFILE_API_RERANKER_PROVIDER=rrf
EVOLVING_PROFILE_DATAPLANE_API_URL=http://127.0.0.1:8888
EVOLVING_PROFILE_CONTROLLER_URL=http://127.0.0.1:12079
EVOLVING_PROFILE_SOURCE_API_URL=http://127.0.0.1:8888
EVOLVING_PROFILE_GUIDANCE_SRC=./guidance
EVOLVING_PROFILE_GUIDANCE_CONFIG=./config/guidance-v1.json
